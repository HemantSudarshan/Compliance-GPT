# ==============================================
# ComplianceGPT Environment Configuration
# ==============================================

# ----------------------------------------------
# LLM Provider Selection (choose ONE)
# Options: openai, gemini, groq
# ----------------------------------------------
LLM_PROVIDER=gemini

# ----------------------------------------------
# Google Gemini (RECOMMENDED - FREE TIER)
# Get key: https://aistudio.google.com/apikey
# Free: 15 requests/min, 1M tokens/day
# ----------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ----------------------------------------------
# Groq (FREE TIER)
# Get key: https://console.groq.com/keys
# Free: 30 requests/min
# ----------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------
# OpenAI (PAID - ~$0.15-0.60 per 1M tokens)
# Get key: https://platform.openai.com/api-keys
# ----------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------
# Weaviate Cloud Vector Database
# Get credentials: https://console.weaviate.cloud
# Free 14-day trial available
# ----------------------------------------------
WEAVIATE_URL=your-weaviate-cluster-url
WEAVIATE_API_KEY=your-weaviate-api-key

# ----------------------------------------------
# Search & Retrieval Settings
# ----------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
HYBRID_ALPHA=0.3

# ----------------------------------------------
# API Settings
# ----------------------------------------------
# Environment (development, production)
ENVIRONMENT=development

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS=30

# CORS allowed origins (comma-separated)
# SECURITY: In production, replace with your domain
# Example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Enable API key authentication
ENABLE_API_AUTH=false

# API keys for authentication (comma-separated)
# Only used if ENABLE_API_AUTH=true
COMPLIANCEGPT_API_KEYS=

# Admin API token for protected endpoints (cache clear, audit logs)
# SECURITY: Generate a strong random token
# Example: ADMIN_API_TOKEN=$(openssl rand -hex 32)
ADMIN_API_TOKEN=

# ----------------------------------------------
# Caching Settings
# ----------------------------------------------
# Cache TTL in seconds (default: 5 minutes)
CACHE_TTL=300

# Maximum cache entries
CACHE_MAX_ENTRIES=1000

# ----------------------------------------------
# Logging & Debug
# ----------------------------------------------
LOG_LEVEL=INFO
DEBUG=false

# ----------------------------------------------
# Multi-Tenancy (Enterprise)
# ----------------------------------------------
# Enable multi-tenant mode
ENABLE_MULTI_TENANCY=false

# Admin API token for tenant management
ADMIN_API_TOKEN=

# ----------------------------------------------
# Observability (Production)
# ----------------------------------------------
# Enable distributed tracing
ENABLE_TRACING=false

# Trace exporter type: console, file, otlp
TRACE_EXPORTER=console

# OTLP endpoint for tracing
OTLP_ENDPOINT=http://localhost:4317

# ----------------------------------------------
# Audit Logging (Enterprise)
# ----------------------------------------------
# Enable audit logging
ENABLE_AUDIT=false

# Audit log file path
AUDIT_LOG_PATH=logs/audit

# Webhook URL for audit events
AUDIT_WEBHOOK_URL=

# ----------------------------------------------
# Feature Flags
# ----------------------------------------------
# Enable response caching
ENABLE_CACHING=true

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Enable Prometheus metrics
ENABLE_METRICS=true

# ----------------------------------------------
# External Services (Optional)
# ----------------------------------------------
# Tavily API for web search
TAVILY_API_KEY=

# Webhook URL for alerts
ALERT_WEBHOOK_URL=

# Slack webhook for notifications
SLACK_WEBHOOK_URL=
